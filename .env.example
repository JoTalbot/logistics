# Development/production environment contract
# Never commit real credentials or production secrets.

# PostgreSQL
POSTGRES_DB=logistics
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://change-me:change-me@postgres:5432/logistics

# Protected operator review API
REVIEW_OPERATOR_TOKEN=replace-with-a-long-random-secret

# API exposure. docker-compose binds this to localhost by default.
API_PORT=8000

# Optional provider secret. Keep empty until official access is verified.
LARDI_API_KEY=
