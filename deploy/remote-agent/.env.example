# Copy to /etc/logistics-agent/agent.env and chmod 600.
AGENT_AUTH_TOKEN=generate-a-long-random-secret
AGENT_WORKSPACE=/opt/logistics
AGENT_COMMAND_TIMEOUT=120
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=replace-with-vercel-ai-gateway-key
AI_MODEL=openai/gpt-6-astra

# Outbound-only Vercel control channel. Leave empty to run local-only.
CONTROL_PLANE_URL=https://logistics-fawn-pi.vercel.app
CONTROL_PLANE_TOKEN=use-the-same-secret-as-Vercel-REMOTE_AGENT_TOKEN
AGENT_NAME=arm-server-01
AGENT_HEARTBEAT_SECONDS=30
